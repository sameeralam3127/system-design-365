<!DOCTYPE html>
<html>
<body style="font-family: Arial, sans-serif; background:#f4f6f8; padding:20px;">

<h2 style="background:#1f2937; color:white; padding:15px; border-radius:6px;">
📦 Patch Compliance Report – {{ report_date }}
</h2>

{% set hosts_with_updates = [] %}
{% for host in groups['ubuntu'] %}
  {% if hostvars[host].pending_patches is defined
        and hostvars[host].pending_patches | length > 0 %}
    {% set _ = hosts_with_updates.append(host) %}
  {% endif %}
{% endfor %}

<table style="background:white; padding:10px; border-radius:6px; width:100%;">
<tr><td><b>Total Hosts:</b> {{ groups['ubuntu'] | length }}</td></tr>
<tr><td><b>Hosts With Updates:</b> {{ hosts_with_updates | length }}</td></tr>
<tr><td><b>Fully Patched:</b> {{ groups['ubuntu'] | length - hosts_with_updates | length }}</td></tr>
</table>

<br>

{% for host in groups['ubuntu'] %}
<div style="background:white; padding:12px; margin-bottom:10px; border-radius:6px;">
<h3>🖥 {{ host }}</h3>

{% if hostvars[host].pending_patches | length > 0 %}
<span style="color:#b91c1c;"><b>❌ Pending Updates</b></span>

<details>
  <summary style="cursor:pointer; margin-top:6px;">View packages</summary>
  <ul>
    {% for patch in hostvars[host].pending_patches %}
      <li>{{ patch }}</li>
    {% endfor %}
  </ul>
</details>

{% else %}
<span style="color:#15803d;"><b>✅ Fully Patched</b></span>
{% endif %}

</div>
{% endfor %}

<p style="font-size:12px; color:#6b7280; text-align:center;">
Generated by Ansible • {{ report_date }}
</p>

</body>
</html>
